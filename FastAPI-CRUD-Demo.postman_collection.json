{
  "info": {
    "name": "FastAPI Persona CRUD - Laboratorio 1",
    "description": "Coleccion completa con los 9 endpoints requeridos + endpoints extras",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "7d4b4d3a-8bf0-4a05-91b1-42f8f3e3f1d1"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "persona_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Personas CRUD",
      "item": [
        {
          "name": "Create Persona",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"phone\": \"+57 3000000000\",\n  \"birth_date\": \"1990-05-20\",\n  \"is_active\": true,\n  \"notes\": \"Cliente frecuente\"\n}"
            },
            "url": { "raw": "{{base_url}}/personas", "host": ["{{base_url}}"], "path": ["personas"] }
          }
        },
        {
          "name": "List Personas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/personas",
              "host": ["{{base_url}}"],
              "path": ["personas"],
              "query": [ { "key": "skip", "value": "0" }, { "key": "limit", "value": "100" } ]
            }
          }
        },
        {
          "name": "Get Persona by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/{{persona_id}}", "host": ["{{base_url}}"], "path": ["personas", "{{persona_id}}"] }
          }
        },
        {
          "name": "Update Persona",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.perez2@example.com\",\n  \"notes\": \"Actualizado\"\n}"
            },
            "url": { "raw": "{{base_url}}/personas/{{persona_id}}", "host": ["{{base_url}}"], "path": ["personas", "{{persona_id}}"] }
          }
        },
        {
          "name": "Delete Persona",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/{{persona_id}}", "host": ["{{base_url}}"], "path": ["personas", "{{persona_id}}"] }
          }
        }
      ]
    },
    {
      "name": "REQUERIDOS Laboratorio",
      "item": [
        {
          "name": "1. DELETE Reset - Borrar todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/reset", "host": ["{{base_url}}"], "path": ["personas", "reset"] }
          }
        },
        {
          "name": "2. POST Poblar - Carga masiva",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"cantidad\": 50\n}" },
            "url": { "raw": "{{base_url}}/personas/poblar", "host": ["{{base_url}}"], "path": ["personas", "poblar"] }
          }
        },
        {
          "name": "3. GET Estadisticas por Dominio",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/estadisticas/dominios", "host": ["{{base_url}}"], "path": ["personas", "estadisticas", "dominios"] }
          }
        },
        {
          "name": "4. GET Estadisticas de Edad",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/estadisticas/edad", "host": ["{{base_url}}"], "path": ["personas", "estadisticas", "edad"] }
          }
        },
        {
          "name": "5. GET Buscar por termino",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/buscar/juan", "host": ["{{base_url}}"], "path": ["personas", "buscar", "juan"] }
          }
        },
        {
          "name": "6. GET Reporte de Activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/reporte/activos", "host": ["{{base_url}}"], "path": ["personas", "reporte", "activos"] }
          }
        },
        {
          "name": "7. GET Cumpleanios del Mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/cumpleanios/mes/12", "host": ["{{base_url}}"], "path": ["personas", "cumpleanios", "mes", "12"] }
          }
        },
        {
          "name": "8. PATCH Desactivacion Masiva",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"ids\": [1, 2, 3, 4, 5]\n}" },
            "url": { "raw": "{{base_url}}/personas/bulk/desactivar", "host": ["{{base_url}}"], "path": ["personas", "bulk", "desactivar"] }
          }
        },
        {
          "name": "9. GET Exportar CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/exportar/csv", "host": ["{{base_url}}"], "path": ["personas", "exportar", "csv"] }
          }
        }
      ]
    },
    {
      "name": "EXTRAS Analitica Avanzada",
      "item": [
        {
          "name": "10. GET Activos Porcentaje",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/analitica/activos-porcentaje", "host": ["{{base_url}}"], "path": ["personas", "analitica", "activos-porcentaje"] }
          }
        },
        {
          "name": "11. GET Rangos de Edad",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/analitica/rangos-edad", "host": ["{{base_url}}"], "path": ["personas", "analitica", "rangos-edad"] }
          }
        },
        {
          "name": "12. GET Top Dominios",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/estadisticas/top-dominios?limite=5", "host": ["{{base_url}}"], "path": ["personas", "estadisticas", "top-dominios"], "query": [ { "key": "limite", "value": "5" } ] }
          }
        },
        {
          "name": "13. GET Personas sin Notas",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/analitica/sin-notas", "host": ["{{base_url}}"], "path": ["personas", "analitica", "sin-notas"] }
          }
        },
        {
          "name": "14. GET Rango de Fechas",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/fechas/rango/1990-01-01/2000-12-31", "host": ["{{base_url}}"], "path": ["personas", "fechas", "rango", "1990-01-01", "2000-12-31"] }
          }
        },
        {
          "name": "15. GET Exportar JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/personas/exportar/json", "host": ["{{base_url}}"], "path": ["personas", "exportar", "json"] }
          }
        }
      ]
    }
  ]
}
